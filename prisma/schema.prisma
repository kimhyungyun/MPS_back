generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model comment {
  id         Int        @id @default(autoincrement())
  content    String     @db.Text
  userId     Int?
  postId     Int?
  created_at DateTime   @default(now()) @db.DateTime(6)
  createdAt  DateTime   @default(now()) @db.DateTime(6)
  post       post?      @relation(fields: [postId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_94a85bb16d24033a2afdd5df060")
  g5_member  g5_member? @relation(fields: [userId], references: [mb_no], onDelete: NoAction, onUpdate: NoAction, map: "FK_c0354a9a009d3bb45a08655ce3b")

  @@index([postId], map: "FK_94a85bb16d24033a2afdd5df060")
  @@index([userId], map: "FK_c0354a9a009d3bb45a08655ce3b")
}

model enrollment {
  id         Int        @id @default(autoincrement())
  progress   Float      @default(0) @db.Float
  enrolledAt DateTime   @default(now()) @db.DateTime(6)
  userId     Int?
  lectureId  Int?
  g5_member  g5_member? @relation(fields: [userId], references: [mb_no], onDelete: NoAction, onUpdate: NoAction, map: "FK_e97ecbf11356b5173ce7fb0b060")
  lecture    lecture?   @relation(fields: [lectureId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_f52053e430680e98e386e62231e")

  @@index([userId], map: "FK_e97ecbf11356b5173ce7fb0b060")
  @@index([lectureId], map: "FK_f52053e430680e98e386e62231e")
}

model g5_member {
  mb_no             Int          @id @default(autoincrement())
  mb_id             String       @unique(map: "IDX_a03747a84d47d35b85373ebbed") @db.VarChar(20)
  mb_password       String       @db.VarChar(255)
  mb_name           String       @db.VarChar(255)
  mb_nick           String       @db.VarChar(255)
  mb_nick_date      DateTime?    @db.Date
  mb_email          String       @db.VarChar(255)
  mb_homepage       String       @db.VarChar(255)
  mb_level          Int          @default(0) @db.TinyInt
  mb_sex            String       @db.VarChar(1)
  mb_birth          String       @db.VarChar(255)
  mb_tel            String       @db.VarChar(255)
  mb_hp             String       @db.VarChar(255)
  mb_certify        String       @db.VarChar(20)
  mb_adult          Int          @default(0) @db.TinyInt
  mb_dupinfo        String       @db.VarChar(255)
  mb_zip1           String       @db.VarChar(3)
  mb_zip2           String       @db.VarChar(3)
  mb_addr1          String       @db.VarChar(255)
  mb_addr2          String       @db.VarChar(255)
  mb_addr3          String       @db.VarChar(255)
  mb_addr_jibeon    String       @db.VarChar(255)
  mb_signature      String       @db.Text
  mb_recommend      String       @db.VarChar(255)
  mb_point          Int          @default(0)
  mb_today_login    DateTime     @default(dbgenerated("'0000-00-00 00:00:00'")) @db.DateTime(0)
  mb_login_ip       String       @db.VarChar(255)
  mb_datetime       DateTime     @default(dbgenerated("'0000-00-00 00:00:00'")) @db.DateTime(0)
  mb_ip             String       @db.VarChar(255)
  mb_leave_date     String       @db.VarChar(8)
  mb_intercept_date String       @db.VarChar(8)
  mb_email_certify  DateTime     @default(dbgenerated("'0000-00-00 00:00:00'")) @db.DateTime(0)
  mb_email_certify2 String       @db.VarChar(255)
  mb_memo           String       @db.Text
  mb_lost_certify   String       @db.VarChar(255)
  mb_mailling       Int          @default(0) @db.TinyInt
  mb_sms            Int          @default(0) @db.TinyInt
  mb_open           Int          @default(0) @db.TinyInt
  mb_open_date      DateTime     @default(dbgenerated("'0000-00-00'")) @db.Date
  mb_profile        String       @db.Text
  mb_memo_call      String       @db.VarChar(255)
  mb_memo_cnt       Int          @default(0)
  mb_scrap_cnt      Int          @default(0)
  mb_school         String?      @db.VarChar(255)
  mb_1              String       @db.VarChar(255)
  mb_2              String       @db.VarChar(255)
  mb_3              String       @db.VarChar(255)
  mb_4              String       @db.VarChar(255)
  mb_5              String       @db.VarChar(255)
  mb_6              String       @db.VarChar(255)
  mb_7              String       @db.VarChar(255)
  mb_8              String       @db.VarChar(255)
  mb_9              String       @db.VarChar(255)
  mb_10             String       @db.VarChar(255)
  mb_password2      String       @db.VarChar(255)

  comment           comment[]
  enrollment        enrollment[]
  lecture           lecture[]
  payment           payment[]
  post              post[]

  // 🔹 동영상 권한 관계
  videoAuthorities  VideoAuthority[]
  videoDevices      VideoDevice[]
}

model lecture {
  id                               Int                                @id @default(autoincrement())
  title                            String                             @db.VarChar(255)
  description                      String                             @db.Text
  price                            Int
  thumbnail_url                    String                             @db.VarChar(255)

  type                             lecture_type                       @default(single)
  created_at                       DateTime                           @default(now()) @db.DateTime(6)
  categoryId                       Int?
  instructorId                     Int?

  video_folder                     String?                            @db.VarChar(255)
  video_name                       String?                            @db.VarChar(255)

  enrollment                       enrollment[]
  g5_member                        g5_member?                         @relation(fields: [instructorId], references: [mb_no], onDelete: NoAction, onUpdate: NoAction, map: "FK_2ca61c8451b53ad2da3c5f6432a")
  lecture_category                 lecture_category?                  @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_8cd71d8895fb3f82f399e605da0")
  lecture_package_lectures_lecture lecture_package_lectures_lecture[]
  payment                          payment[]

  classGroup                       ClassGroup                         @default(S) @map("classGroup")

  @@map("lecture")
  @@index([instructorId], map: "FK_2ca61c8451b53ad2da3c5f6432a")
  @@index([categoryId], map: "FK_8cd71d8895fb3f82f399e605da0")
}

model lecture_category {
  id      Int       @id @default(autoincrement())
  name    String    @unique(map: "IDX_d06caca712269056db0d721582") @db.VarChar(255)
  lecture lecture[]
}

model lecture_package {
  id                               Int                                @id @default(autoincrement())
  name                             String                             @db.VarChar(255)
  price                            Int
  lecture_package_lectures_lecture lecture_package_lectures_lecture[]

  // payment 와의 양방향 관계
  payments                         payment[]                          @relation("PaymentLecturePackage")
}

model lecture_package_lectures_lecture {
  lecturePackageId Int
  lectureId        Int
  lecture          lecture         @relation(fields: [lectureId], references: [id], onDelete: Cascade, map: "FK_4cfd2a1323cacb8037653fd5745")
  lecture_package  lecture_package @relation(fields: [lecturePackageId], references: [id], onDelete: Cascade, map: "FK_7b163402722fc3ddc6af8ec5039")

  @@id([lecturePackageId, lectureId])
  @@index([lectureId], map: "IDX_4cfd2a1323cacb8037653fd574")
  @@index([lecturePackageId], map: "IDX_7b163402722fc3ddc6af8ec503")
}

model post {
  id            Int              @id @default(autoincrement())
  title         String           @db.VarChar(255)
  content       String           @db.Text
  category      post_category
  created_at    DateTime         @default(now()) @db.DateTime(6)
  userId        Int?

  // 중요 여부
  is_important  Boolean          @default(false)

  // 대표 이미지
  coverImageUrl String?          @db.VarChar(500)

  // 댓글
  comment       comment[]

  // 첨부파일
  attachments   post_attachment[]

  // 작성자
  g5_member     g5_member?       @relation(fields: [userId], references: [mb_no])

  @@index([userId], map: "FK_5c1cf55c308037b5aca1038a131")
}

model post_attachment {
  id        Int      @id @default(autoincrement())
  post      post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int

  fileName  String   @db.VarChar(255)
  fileUrl   String   @db.VarChar(500)
  fileSize  Int?
  mimeType  String?  @db.VarChar(100)

  createdAt DateTime @default(now()) @db.DateTime(6)

  @@index([postId])
}

model File {
  id           Int          @id @default(autoincrement())
  key          String       // S3 key 
  originalName String       // 원래 파일명 (업로드 당시 이름)
  size         Int          // 바이트 단위 크기
  mimeType     String       // 컨텐츠 타입 (application/pdf, image/png 등)
  category     FileCategory // NOTICE / DATAROOM / OTHER

  uploaderId   String       // 업로더 식별자 (mb_id 같은 것)
  uploaderNick String?      // 업로더 닉네임

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // 유저 테이블 FK가 필요하면 여기 연결 가능
}

model PasswordReset {
  id         Int      @id @default(autoincrement())
  mb_id      String
  phone      String
  code       String?   // SMS 인증 코드
  resetToken String?   // 비밀번호 재설정 토큰
  expiresAt  DateTime
  used       Boolean   @default(false)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model VideoAuthority {
  id         Int         @id @default(autoincrement())
  userId     Int
  classGroup ClassGroup?
  type       lecture_type?
  created_at DateTime    @default(now()) @db.DateTime(6)
  updated_at DateTime    @updatedAt @db.DateTime(6)

  user       g5_member   @relation(fields: [userId], references: [mb_no])

  @@index([userId])
  @@unique([userId, classGroup, type])
  @@map("video_authority")
}

model VideoDevice {
  id         Int       @id @default(autoincrement())
  userId     Int
  deviceId   String    // 브라우저에서 생성해서 보내는 기기 식별자 (localStorage 기반)
  deviceName String?   // 기기명 (예: Chrome on Windows, iPhone Safari)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())

  user       g5_member @relation(fields: [userId], references: [mb_no])

  @@index([userId])
  @@unique([userId, deviceId])
  @@map("video_device")
}

model DataroomFile {
  id           Int          @id @default(autoincrement())
  key          String       @unique
  originalName String
  size         Int?
  mimeType     String
  uploaderId   String
  uploaderNick String?
  createdAt    DateTime     @default(now())

  kind         DataroomKind @default(DATA1)

  @@index([uploaderId])
  @@index([kind])
}

model payment {
  id               Int                   @id @default(autoincrement())
  amount           Int
  paymentStatus    payment_paymentStatus @default(pending)
  paymentMethod    payment_paymentMethod
  created_at       DateTime              @default(now()) @db.DateTime(6)
  userId           Int?
  lectureId        Int?                  // 과거 단일 강의용. 지금은 안 써도 됨
  lecture          lecture?              @relation(fields: [lectureId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_7c58ca1eceb0b74aa4ef4b21a6c")
  g5_member        g5_member?            @relation(fields: [userId], references: [mb_no], onDelete: NoAction, onUpdate: NoAction, map: "FK_b046318e0b341a7f72110b75857")

  // 🔹 Toss 결제 연동용 필드
  orderId          String                @unique @db.VarChar(100)   // PG에 넘기는 주문번호
  paymentKey       String?               @unique @db.VarChar(200)   // Toss paymentKey
  provider         String                @default("TOSS") @db.VarChar(50)
  approvedAt       DateTime?             @db.DateTime(6)
  receiptUrl       String?               @db.VarChar(500)

  // 🔹 어떤 패키지를 산 건지 (실제 판매 단위)
  lecturePackageId Int?
  lecture_package  lecture_package?      @relation("PaymentLecturePackage", fields: [lecturePackageId], references: [id])

  @@index([lectureId], map: "FK_7c58ca1eceb0b74aa4ef4b21a6c")
  @@index([userId], map: "FK_b046318e0b341a7f72110b75857")
  @@index([lecturePackageId])
}

enum payment_paymentStatus {
  pending
  completed
  failed
  refunded
  cancelled
}

enum payment_paymentMethod {
  credit_card
  bank_transfer
  virtual_account
  mobile_payment
}

enum post_category {
  notice
  qna
  free
  review
}

enum ClassGroup {
  A
  B
  S
}

enum lecture_type {
  single
  packageA
  packageB
  packageC
  packageD
  packageE
}

enum FileCategory {
  NOTICE    // 게시판 첨부
  DATAROOM  // 자료실
  OTHER     // 그 외 필요하면
}

enum DataroomKind {
  DATA1
  DATA2
}
